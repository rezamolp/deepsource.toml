# Bot token from BotFather
BOT_TOKEN=

# Primary admin Telegram user ID (integer)
ADMIN_ID=

# Optional fallback chat ID for admin messages (e.g. a private control group)
ADMIN_FALLBACK_CHAT_ID=

# Telethon API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Channel ID (e.g. -1001234567890). The bot must be admin in this chat
TARGET_CHAT_ID=

# Anti-spam defaults
JOIN_THRESHOLD=10
JOIN_WINDOW_SECONDS=60
VIEW_THRESHOLD=50
VIEW_WINDOW_SECONDS=60
VIEW_MONITOR_POLL_SECONDS=10

# Link rotation base username (without suffix)
ROTATION_BASE=guardian
ROTATION_SUFFIX_MAX=100

# HTTP health server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Database path
DATABASE_URL=sqlite+sqlite:///guardian.sqlite3

# Logging
LOG_LEVEL=INFO
